# Canonical public URL. Server-side configuration; use the final domain at launch.
SITE_URL=https://www.bmygym.com

# Keep false for drafts. Set true only in the Vercel Production environment
# after approving content, domain, privacy information and the enquiry flow.
# Development and Vercel Preview deployments remain excluded even when true.
ENABLE_INDEXING=false

# Enquiry delivery through Resend. No key is required for the site to render.
# Use a sender address on a domain verified in your Resend account.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=hello@bmygym.com
